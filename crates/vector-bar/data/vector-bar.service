[Unit]
Description=Vector Bar (top bar)
# Supervised: comes back by itself if it ever dies. `waybar` (the shim in
# ~/.local/bin) starts this unit, so Omarchy's restart/toggle scripts keep working.
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Slice=app-graphical.slice
# Omarchy's "hide the bar" toggle: stay off while its flag file exists
ExecCondition=/bin/sh -c '! test -f %h/.local/state/omarchy/toggles/waybar-off'
ExecStart=%h/.local/bin/vector-bar
ExecReload=%h/.local/bin/vector-bar reload
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=15

[Install]
WantedBy=graphical-session.target
