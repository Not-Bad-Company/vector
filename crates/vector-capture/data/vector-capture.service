[Unit]
Description=Vector Capture (screenshots, colour picker, recording, text from screenshots)
# Resident so the capture keys answer instantly.
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Slice=app-graphical.slice
ExecStart=%h/.local/bin/vector-capture-daemon --service
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
