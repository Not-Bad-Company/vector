[Unit]
Description=Vector Space (launcher, clipboard history, notifications, emoji, convert)
# Resident so super+space opens instantly; also records the clipboard.
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Slice=app-graphical.slice
ExecStart=%h/.local/bin/vector-space-daemon --service
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
