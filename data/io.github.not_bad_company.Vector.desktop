[Desktop Entry]
Type=Application
Name=Vector Find
GenericName=File Manager
Comment=Browse files with the mouse or nvim-style keys
Exec=vector-find %U
Icon=io.github.not_bad_company.Vector
Terminal=false
Categories=System;FileManager;Utility;
MimeType=inode/directory;
StartupWMClass=io.github.not_bad_company.Vector
Keywords=files;folders;browser;explorer;
